{
  "name": "@clichat/plugin-mcp",
  "version": "0.1.0",
  "description": "MCP context plugin for clichat — auto-configure MCP servers for AI CLIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
